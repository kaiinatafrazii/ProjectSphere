PORT=5000
JWT_SECRET=change-me-in-production

# MySQL / XAMPP Configuration
# Local XAMPP defaults: root user with empty password on port 3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=projectsphere_app
DB_CONNECTION_LIMIT=10

# Cloud MySQL (Render / TiDB / Aiven / Railway)
# You can provide a single connection string instead of individual DB_* variables:
# DATABASE_URL=mysql://user:password@host:port/database_name

# Production / Render MySQL SSL settings
# Enable TLS for production providers that require SSL (e.g. Render, TiDB, Aiven)
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=false

# Private source archives must be stored outside public web directories.
SOURCE_CODE_STORAGE_DIR=./data/private-source-code
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SAME_SITE=lax

# Mail configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Administrator initialization
ADMIN_EMAIL=kainatafrazii11@gmail.com
# Enter the administrator password locally; do not commit it or share it in chat.
ADMIN_PASSWORD=
