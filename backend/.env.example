PORT=5000
JWT_SECRET=change-me-in-production
# Relative paths resolve from the backend working directory.
SQLITE_DB_PATH=./data/projectsphere.sqlite
# Private source archives are stored outside public web directories by default.
SOURCE_CODE_STORAGE_DIR=./data/private-source-code
# MySQL is used only by the explicit `npm run migrate:mysql` import command.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=projectsphere
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=kainatafrazii11@gmail.com
# Enter the administrator password locally; do not commit it or share it in chat.
ADMIN_PASSWORD=
